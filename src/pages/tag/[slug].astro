---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, groupBy, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const groups = groupBy(await getPosts(), 'tags');
  return [...groups].map(([slug, { name, posts }]) => ({ params: { slug }, props: { name, posts } }));
}

interface Props {
  name: string;
  posts: Post[];
}

const { name, posts } = Astro.props;
---

<Base title={name}>
  <header class="archive-header">
    <p class="meta">Tag</p>
    <h1>{name}</h1>
    <p class="meta">{posts.length} {posts.length === 1 ? 'wpis' : 'wpisów'}</p>
  </header>
  {posts.map((post) => <PostCard post={post} />)}
</Base>
