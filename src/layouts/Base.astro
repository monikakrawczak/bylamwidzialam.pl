---
import '../styles/global.css';
import { NAV, SITE_DESCRIPTION, SITE_TITLE } from '../lib/posts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description = SITE_DESCRIPTION, image } = Astro.props;
const fullTitle = title ? `${title} – ${SITE_TITLE}` : `${SITE_TITLE} – ${SITE_DESCRIPTION}`;
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' || path.startsWith('/page/') : path.startsWith(href));
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={title ?? SITE_TITLE} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="site-title" href="/">{SITE_TITLE}</a>
      <p class="site-description">{SITE_DESCRIPTION}</p>
      <nav aria-label="Menu główne">
        <ul>
          {NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>© 2016–{new Date().getFullYear()} {SITE_TITLE} · <a href="/rss.xml">RSS</a></p>
    </footer>
  </body>
</html>
